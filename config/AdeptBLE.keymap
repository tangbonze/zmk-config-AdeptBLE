#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

// #include <dt-bindings/zmk/mouse.h>

#define DEFAULT 0
#define SCRLM 1
#define SCRLH 2
#define DEVICE 3
#define BLTH 4
#define SNIPE 5

/ {
  combos {
    compatible = "zmk,combos";
    combo_esc {
      timeout-ms = <50>;
      key-positions = <2 3>;
      bindings = <&mkp RCLK>;
    };
  };
  behaviors {
    ltm: layer-tap-momentary {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "tap-preferred";
      tapping-term-ms = <200>;
      bindings = <&mo>, <&mkp>;
    };
    lth: layer-tap-hold-while-undecided {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "hold-preferred";
      hold-while-undecided;
      tapping-term-ms = <150>;
      bindings = <&mo>, <&mkp>;
    };
    mto: momentary-or-toggle {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "hold-preferred";
      hold-while-undecided;
      tapping-term-ms = <200>;
      bindings = <&mo>, <&to>;
    };
  };
  keymap {
    compatible = "zmk,keymap";
    default_layer {
      display-name = "Default";
      bindings = <
        &ltm BLTH MB4 &ltm DEVICE MB5 &mkp MCLK &lth SCRLM RCLK
        &mkp LCLK                               &mto SCRLM SNIPE
      >;
    };
    scroll_tap_layer {
      display-name = "Scroll-Momentary";
      bindings = <
        &trans &trans &to SCRLH &trans
        &to SCRLH               &trans
      >;
    };
    scroll_hold_layer {
      display-name = "Scroll-Keep";
      bindings = <
        &trans &trans &trans &to DEFAULT
        &trans               &to DEFAULT
      >;
    };
    device_layer {
      display-name = "Device";
      // Hold the DEVICE key to reach these: k3 = play runtime macro 0
      // (created in DYA Studio; an empty slot does nothing). There is no
      // &studio_unlock binding on purpose: locking is disabled, so the
      // keyboard is always unlocked.
      bindings = <
        &bootloader &trans &trans &rmacro 0
        &trans                       &bt BT_CLR
      >;
    };
    bluetooth_layer {
      display-name = "Bluetooth";
      bindings = <
        &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2
        &bt BT_SEL 3                     &bt BT_SEL 4
      >;
    };
    snipe_layer {
      display-name = "Snipe";
      bindings = <
        &trans &trans &trans &lth SCRLM RCLK
        &trans               &to DEFAULT
      >;
    };
  };
};

// ---------------------------------------------------------------------------
// Trackball runtime input processors (DYA Studio "Trackball" tab)
//
// The defaults live in <input/processors/runtime-input-processor.dtsi>; only
// the behaviour that is specific to this keyboard is set here. Everything else
// (speed, rotation, axis snap, inertia, ...) can be changed from DYA Studio
// and is stored in the keyboard's settings.
//
// mouse_runtime_input_processor is deliberately left at its defaults (1:1
// scaling, no rotation), which matches the static processor chain it replaced.
// ---------------------------------------------------------------------------

&scroll_runtime_input_processor {
    // The processor receives raw XY movement and converts it to wheel events.
    x-codes = <INPUT_REL_X>;
    y-codes = <INPUT_REL_Y>;
    xy-to-scroll-enabled;
    // Preserves the previous 1/10 scroll scaling; adjustable in DYA Studio.
    scale-divisor = <10>;
    axis-snap-threshold = <100>;
    // Only on layers 1 (SCRLM) and 2 (SCRLH), as a bitmask.
    active-layers = <0x00000006>;
};